okeColor=#000000;verticalLabelPosition=middle;verticalAlign=middle;spacingLeft=4;spacingRight=4;fontSize=11;labelPosition=left;align=right;" vertex="1" parent="1"><mxGeometry x="1543.15" y="1579" width="12" height="12" as="geometry"/></mxCell><mxCell id="c157" value="" style="endArrow=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c156" target="c146"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c158" value="cep" style="ellipse;aspect=fixed;html=1;fillColor=#ffffff;strokeColor=#000000;verticalLabelPosition=middle;verticalAlign=middle;spacingLeft=4;spacingRight=4;fontSize=11;labelPosition=left;align=right;" vertex="1" parent="1"><mxGeometry x="1543.15" y="1603" width="12" height="12" as="geometry"/></mxCell><mxCell id="c159" value="" style="endArrow=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c158" target="c146"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c160" value="Modelo Conceitual (DER) - Controle de Estacionamento" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="40" as="geometry"/></mxCell><mxCell id="c161" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Retângulo&lt;/b&gt;: entidade &amp;nbsp;|&amp;nbsp; &lt;b&gt;retângulo duplo&lt;/b&gt;: entidade fraca&lt;br&gt;&lt;b&gt;Losango&lt;/b&gt;: relacionamento &amp;nbsp;|&amp;nbsp; &lt;b&gt;losango duplo&lt;/b&gt;: relacionamento identificador&lt;br&gt;&lt;b&gt;●&lt;/b&gt; atributo identificador &amp;nbsp;|&amp;nbsp; &lt;b&gt;○&lt;/b&gt; atributo simples&lt;br&gt;&lt;b&gt;● tracejado&lt;/b&gt;: identificador parcial (da entidade fraca)&lt;br&gt;&lt;b&gt;◎&lt;/b&gt; atributo multivalorado &amp;nbsp;|&amp;nbsp; &lt;b&gt;○ tracejado&lt;/b&gt;: atributo derivado&lt;br&gt;Atributo com filhos: atributo composto &amp;nbsp;|&amp;nbsp; &lt;b&gt;(0,1)&lt;/b&gt; no atributo: opcional&lt;br&gt;&lt;br&gt;&lt;b&gt;Cardinalidade (mín, máx)&lt;/b&gt;: o par escrito junto a uma entidade diz&lt;br&gt;quantas ocorrências &lt;i&gt;dela&lt;/i&gt; se ligam a &lt;b&gt;uma&lt;/b&gt; ocorrência da entidade&lt;br&gt;do outro lado do losango.&lt;br&gt;Ex.: MARCA &lt;b&gt;(1,1)&lt;/b&gt; — possui — &lt;b&gt;(1,N)&lt;/b&gt; MODELO: cada modelo é de&lt;br&gt;exatamente 1 marca; cada marca possui de 1 a N modelos.&lt;br&gt;Mínimo 0 = participação opcional; mínimo 1 = obrigatória." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1640" y="20" width="440" height="215" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>